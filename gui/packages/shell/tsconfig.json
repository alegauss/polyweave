{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node, and no DOM: a `document` in scope here is a mistake worth catching in the
    // compiler rather than in review.
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist-types",
    "tsBuildInfoFile": "dist-types/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"],
  "references": [{ "path": "../core" }]
}
