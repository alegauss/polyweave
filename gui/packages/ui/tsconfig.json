{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // A web page: the DOM and nothing of Node. What the machine knows arrives through the
    // bridge the preload hands over.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "rootDir": "src",
    "outDir": "dist-types",
    "tsBuildInfoFile": "dist-types/.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": ["src/**/*.test.ts"],
  "references": [{ "path": "../core" }]
}
