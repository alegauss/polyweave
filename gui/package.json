{
  "name": "polyweave-gui",
  "private": true,
  "version": "0.0.0",
  "description": "A desktop window onto the polyweave projects on a machine. core reads what a held polyweave serve answers; ui renders it; shell is the Electron process that owns every path.",
  "license": "MIT",
  "author": "Alexandre Oliveira",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "build": "npm run build -w @pw/ui && npm run build -w @pw/shell",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "main": "packages/shell/dist/main.js"
}
